    "\n",
    "    # TODO: Loop and print matching expenses\n",
    "    found = False\n",
    "    \n",
    "    for expense in expenses_list:\n",
    "        if expense[\"category\"] == chosen_category:\n",
    "            print(f\"${expense['amount']} - {expense['description']}\")\n",
    "            found = True\n",
